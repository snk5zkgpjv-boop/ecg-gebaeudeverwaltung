DATABASE_URL=
ORGANIZATION_API_URL=https://erhard-dryland-schadenmanagement.vercel.app
ORGANIZATION_SYNC_TOKEN=
ORGANIZATION_SYNC_USER_EMAIL=
GOOGLE_CALENDAR_ID=
# Nur der ausdrücklich freigegebene gemeinsame Abwesenheitskalender.
ECG_PASTORAL_ABSENCE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_ICAL_URL=
# Erst nach Betreiberprüfung des Google-Dienstkontos (Schreibrechte am Zielkalender) aktivieren.
# Bei false/leer ist das Anlegen von Google-Terminen über die App gesperrt.
GOOGLE_CALENDAR_WRITE_ENABLED=false
# Für die einfache persönliche Verbindung genügt die geheime Google-iCal-Adresse.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
RESEND_API_KEY=
AUTH_FROM_EMAIL=
# PFLICHT in Vercel Production: kanonische öffentliche HTTPS-Adresse für Kennwort-Reset-Links.
# Ohne gültige PUBLIC_APP_URL werden keine Reset-Mails versendet.
PUBLIC_APP_URL=https://ecg-gebaeudeverwaltung-jn5h.vercel.app
